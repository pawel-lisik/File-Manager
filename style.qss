QMainWindow {
	background: white;
}

QLabel#preview {
	background: white;
}	

QLabel {
	color: #333;
}


QWidget#bottom {
    background-color: #f3f3f3;
    color: #7a7a7a;
	border-top: 1px solid #dddddd;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;
}

QMenuBar {
    background-color: #dddddd;
}

QPushButton#btm {
    color: #7a7a7a;
	font-family: "Segoe UI", "Helvetica Neue", sans-serif;
	font-size: 21px;
}

QWidget#window {
	background: white;
	border:none;
}

QWidget#top {
    background-color: #f3f3f3;
	border-bottom: 2px solid #dddddd;
    color: #333;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;
	margin-top: 0px;
}


QWidget#panel {
    background-color: #f3f3f3;
    color: #333;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;
}

QDialog {
	background-color: #f3f3f3;
	color: #333;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;
}
	

QWidget#line {
	background-color: #e9e9e9;
}

QWidget#sidebar {
	background: #e9e9e9;
}

QScrollArea#sidebar2 {
	background: #e9e9e9;
	border: none;
	border-right: 2px solid #dbdbdb;
}

QWidget#sep {
	background: #dbdbdb;
}

QWidget#seplight {
	background: #ececec;
}

QWidget#trash {
	border-bottom: 2px solid #ececec
}

QListWidget {
    border: none;
    background-color: #e9e9e9;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;	
	padding: 0px;
	margin: 0px;
}

QListWidget::item:hover {
	outline: none;
	border: none;
	background: none;
	padding: 0px;
	margin: 0px;
}


QListWidget::item:selected {
    background-color: #d0e3ff;
    color: black;
    border-radius: 12px;
	margin: 0px;
	padding: 1px;
	outline: none;
	border: none;
}

QListWidget::item:focus {
	outline: none;
	border: none;
}
QListWidget::item:selected:focus {
	outline: none;
	border: none;
}





QTreeView {
	background-color: white;
	alternate-background-color: #f8f8f8;
	gridline-color: transparent;
	border-radius: 0px;
	font-size: 26px;
}                
QTreeView::item:selected {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
}

QTreeView::item {
	padding-left: 12px;
	padding-right: 12px;
	outline: none;
	border: none;
} 

QTreeView::item:selected:hover {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
}
QTreeView::item:hover {
	background-color: none;
	outline: none;
	border: none;
}

QTreeView:focus,
QTreeView::item:focus,
QTreeView::item:!active {
    outline: none;
    border: none;
}


QHeaderView::section {
	background-color: white;
	padding: 2px;
	border: none;
	border-bottom: 2px solid #dddddd;
	border-left: 1px solid #ececec;
	border-right: 1px solid #ececec;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;
}

QListView {
	background-color: white;
	alternate-background-color: #f8f8f8;
    font-size: 26px;
	font-family: "Segoe UI";
	color: #333;
}

QListView::item:selected {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
	border-radius: 12px;
}

QListView::item:selected:hover {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
	border-radius: 12px;
}
QListView::item:hover {
	background-color: none;
	outline: none;
	border: none;
}

QListView:focus,
QListView::item:focus,
QListView::item:!active {
    outline: none;
    border: none;
}




QColumnView {
	background-color: #f9f9f9;
	border-radius: 0px;
	font-size: 26px;
}                
QColumnView::item:selected {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
}

QColumnView::item {
	padding: -1px;
	outline: none;
	border: none;
} 

QColumnView::item:selected:hover {
	background-color: #0064e1;
	color: white;
	outline: none;
	border: none;
}
QColumnView::item:hover {
	background-color: none;
	outline: none;
	border: none;
}

QColumnView:focus,
QColumnView::item:focus,
QColumnView::item:!active {
    outline: none;
    border: none;
}

QColumnView,
QColumnView QListView,
QColumnView QTreeView,
QColumnView QAbstractItemView {
    font-size: 26px;
	font-family: "Segoe UI";
}













QLabel#preview {
	background-color: white;
	border-bottom: 2px solid #d0d0d0;
}
QScrollArea#scroll {
	background-color: white;
}
QScrollArea {
	background-color: transparent;
}

QToolButton {
    background: transparent;
    border: none;
    padding: 4px;
}

QToolButton:checked {
    background-color: #dbdbdb;
    border-radius: 5px;
}



QLabel#header {
	color: #666;
	font-family: "Segoe UI", "Helvetica Neue", sans-serif;
	font-size: 23px;
}



QPushButton {
    background-color: white; 
    border: 1px solid #cccccc;
    border-radius: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
	padding-left: 15px;
	padding-right: 15px;
	color: black;
	font-size: 25px;
}


QPushButton:pressed {
    background-color: #0064e1; 
    border: 1px solid #001c40;
	color: white;
}





QScrollBar:vertical {
	background-color: rgba(135, 135, 135, 0.00);
	width: 12px;
	margin: 0px;
	margin-right: 1px;
}

QScrollBar::handle:vertical {
	background: rgba(180, 180, 180, 0.50);
	min-height: 20px;
	border-radius: 4px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
	height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
} 
QScrollBar:horizontal {
	background-color: rgba(135, 135, 135, 0.00);
	height: 12px;
	margin: 0px;
	margin-bottom: 1px;
}

QScrollBar::handle:horizontal {
	background: rgba(180, 180, 180, 0.50);
	min-width: 20px;
	border-radius: 4px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
	width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background: none;
}

QLineEdit {
    background-color: white; 
    border: 1px solid #d5d5d5;
    padding-left: 15px;
    border-radius: 8px;
	color: black;
}

QLineEdit#rename {
    background-color: #0064e1; 
    border: none;
	color: white;
}

QMenu {
	background-color: rgba(236, 236, 236, 240);
	color: black;
}
QMenu::item:selected {
	background-color: rgba(135, 135, 135, 100)
} 

QWidget#forbiddenOverlay {
	background-color: rgba(255, 0, 0, 50);
	border-radius: 32px;
	border: 2px solid rgba(255, 255, 255, 200);
}


QListWidget#sidebar {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 26px;	
	padding: 0px;
	margin: 0px;
}
QListWidget#sidebar::item:hover {
	outline: none;
	border: none;
	background: none;
	padding: 0px;
	margin: 0px;
}

QListWidget#sidebar::item {
	padding: 0px;
}


QListWidget#sidebar::item:selected {
    background-color: #cecece;
    color: black;
    border-radius: 12px;
	margin: 0px;
	padding: 1px;
	outline: none;
	border: none;
}
QListWidget#sidebar::item:focus {
	outline: none;
	border: none;
}
QListWidget#sidebar::item:selected:focus {
	outline: none;
	border: none;
} 


QPushButton#tag_item {
	color: black;
	background: none;
	padding-top: 2px;
	padding-bottom: 2px;
}

QPushButton#tag_item:pressed {
	color: black;
	background-color: #cecece;
	border-radius: 12px;
}
QPushButton#tag_item:selected {
	color: black;
	background-color: #cecece;
	border-radius: 12px;
}